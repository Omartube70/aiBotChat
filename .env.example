# ==== Gemini (Google AI Studio - الطبقة المجانية) ====
# احصل على المفتاح من: https://aistudio.google.com/apikey
GEMINI_API_KEY=ضع_مفتاح_Gemini_هنا
# gemini-flash-lite-latest: أعلى حصة مجانية وردود مباشرة. بديل أجود: gemini-flash-latest
GEMINI_MODEL=gemini-flash-lite-latest

# ==== WhatsApp Cloud API (من Meta / developers.facebook.com) ====
# رقم الـ Phone Number ID بتاع رقم البوت (مش الرقم نفسه)
WHATSAPP_PHONE_NUMBER_ID=
# توكن الوصول الدائم (Permanent Access Token) من System User
WHATSAPP_TOKEN=
# أي نص من اختيارك — بتحطه هنا وفي إعدادات الـ Webhook في Meta بالظبط
WHATSAPP_VERIFY_TOKEN=quds-bot-verify-123
# نسخة الـ Graph API
WHATSAPP_GRAPH_VERSION=v21.0

# ==== متجر Inyad / Mahaal ====
STORE_SLUG=httpsgcokgspyk1uqu
INYAD_API_BASE=https://api.inyad.com/storefront
# مفتاح الـ storefront العام (الموجود أصلاً في كود الموقع) — سيبه زي ما هو غالباً
INYAD_API_KEY=yhLyRgMw!5je4pN*jrx6

# ==== إعدادات عامة ====
PORT=3000
# كل قد إيه (بالثواني) نحدّث كاش المنتجات
CATALOG_TTL_SECONDS=300
